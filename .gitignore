# 构建产物（不打入仓库；CI 上由 workflow 现场构建）
dist/
build/
*.spec.bak

# 本地虚拟环境
.venv/
.venv-build/
.venv-win/

# Python 缓存
__pycache__/
*.py[cod]
.pytest_cache/

# 运行时数据（用户机器上生成，不入库）
logs/
logs_test/
output/
*.log

# doc/ 下的真实数据文件不入库（仅保留模板与文档）
doc/*.xlsx
!doc/财务计算模板.xlsx

# 系统垃圾
.DS_Store
Thumbs.db
desktop.ini
